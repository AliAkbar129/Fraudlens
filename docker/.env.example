# Local development only. Generate APP_KEY before starting.
APP_ENV=local
APP_KEY=
DB_DATABASE=fraudlens
DB_USERNAME=fraudlens
DB_PASSWORD=local-development-only
DB_ROOT_PASSWORD=local-root-development-only
MONGO_INITDB_ROOT_USERNAME=localadmin
MONGO_INITDB_ROOT_PASSWORD=local-development-only
MONGODB_URI=mongodb://localadmin:local-development-only@mongodb:27017
ML_API_KEY=local-ml-only
LOG_LEVEL=INFO
